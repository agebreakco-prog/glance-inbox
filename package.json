{
  "name": "glance-inbox",
  "private": true,
  "version": "0.1.0",
  "description": "Glance Inbox: Telegram messages on Even Realities G2 glasses, with one-tap AI quick replies.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "vite --host",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "sim": "node node_modules/@evenrealities/evenhub-simulator/bin/index.js http://localhost:5173 --automation-port 9898",
    "build": "tsc --noEmit && vite build",
    "pack": "npm run build && evenhub pack app.json dist -o glance-inbox.ehpk",
    "test": "node --test test/*.test.mjs",
    "capture": "node scripts/capture.mjs",
    "sim:headless": "xvfb-run -a -s '-screen 0 1600x1000x24' node node_modules/@evenrealities/evenhub-simulator/bin/index.js http://localhost:5173 --automation-port 9898",
    "video": "node scripts/record-video.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.13.0",
    "@evenrealities/even_hub_sdk": "^0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "^0.2.0",
    "@evenrealities/evenhub-simulator": "^0.9.5",
    "@napi-rs/canvas": "^1.2.0",
    "esbuild": "^0.21.5",
    "ffmpeg-static": "^5.3.0",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0"
  }
}
