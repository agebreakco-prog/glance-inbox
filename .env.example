# Copy to .env and fill in. Never commit .env.
# Everything is optional: with nothing set, the server runs in DEMO mode
# with fictional messages and rule-based quick replies.

# --- Telegram (use a TEST bot from @BotFather) ---
TELEGRAM_BOT_TOKEN=
# Comma-separated chat IDs to show on the glasses. Leave empty once to see IDs in the server log.
TELEGRAM_ALLOWED_CHAT_IDS=
# Force demo mode even when a token is set (1 = on)
DEMO_MODE=

# --- AI reply drafts, digest and voice clean-up (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
LLM_TIMEOUT_MS=8000

# --- Voice replies: any OpenAI-compatible /audio/transcriptions endpoint ---
# e.g. a local whisper.cpp server: http://127.0.0.1:8080/v1/audio/transcriptions
STT_URL=
STT_API_KEY=
STT_MODEL=whisper-1

# --- For shops: customer context line on the card (see examples/customers.json) ---
# JSON file keyed by Telegram user id; re-read on change; the webhook writes to it.
CUSTOMER_CONTEXT_FILE=
# Or ask your own system: GET <url>?user_id=<telegram id> returning the same JSON shape.
CUSTOMER_CONTEXT_URL=
CUSTOMER_CONTEXT_TOKEN=
# Secret for POST /api/shop/order (header x-shop-token). Webhook is off when empty.
SHOP_HOOK_TOKEN=

# --- For teams: claim lock when several staff answer one bot ---
# How long a "Being answered by <name>" claim lasts without activity.
CLAIM_TTL_MS=120000

# --- Server ---
PORT=8787
# Optional shared secret; set the same value as VITE_APP_TOKEN for the web app.
APP_TOKEN=

# --- Web app (Vite) ---
# Where the glasses app reaches the server. Default: same host, port 8787.
VITE_API_BASE=
VITE_APP_TOKEN=
# Name shown to other staff ("Being answered by <name>"). Also settable with ?staff=Name.
VITE_STAFF_NAME=
